# 環境変数のひな形。
# ローカル開発: .env.local にコピーして使う（Next.js が自動で読み込む）。
# 本番（VPS）: /etc/sukikiraivrc/env に置き、systemd の EnvironmentFile で読み込む。

# --- 必須 ---------------------------------------------------------------

# SQLite のパス。未設定なら file:data/sukikirai.db（リポジトリ直下の data/）。
# 本番の例: file:/var/lib/sukikiraivrc/sukikirai.db
DATABASE_URL=file:data/sukikirai.db

# Better Auth の baseURL。本番は https://sukikiraivrc.com。
# ローカルで本番ドメインのままだと Discord OAuth のコールバックが本番へ飛んで失敗する。
SITE_URL=http://localhost:3000

# セッション Cookie の署名鍵。下のコマンドで生成した長いランダム文字列を入れる。
#   node -e "console.log(crypto.randomUUID().replace(/-/g,'')+crypto.randomUUID().replace(/-/g,''))"
BETTER_AUTH_SECRET=

# コメントの匿名IDを導出するソルト。上と同じ方法で生成する。
# 変更すると過去コメントの匿名IDがすべて変わるため、本番では固定すること。
ANON_ID_SALT=

# Discord OAuth。https://discord.com/developers/applications で作成する。
# Redirects に http://localhost:3000/api/auth/callback/discord を追加すること。
# 未設定でも起動はするが、ログインを伴う操作（投票・コメント・登録）は試せない。
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- 任意 ---------------------------------------------------------------

# 管理画面（/admin）に入れる Discord ユーザーID。カンマ区切りで複数可。
# Discord の設定で開発者モードを有効にし、自分を右クリック →「ユーザーIDをコピー」で取得する。
# 未設定なら誰も入れない（/admin は404、/api/admin は403）。
ADMIN_DISCORD_IDS=

# Sentry のエラー追跡。未設定ならエラー送信をスキップする。
# Sentry のプロジェクト設定 → Client Keys (DSN) の値。
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# 通報の通知先。未設定なら通知をスキップして DB 保存のみ行う。
REPORT_WEBHOOK_URL=

# VRChat の表示名・画像の取得に使う専用アカウント。本アカウントは使わないこと。
# 2段階認証は TOTP（認証アプリ）で設定し、そのBase32シークレットを控える。
# 未設定の場合、ワールド（wrld_）は取得できるが、
# ユーザー・アバター・グループ（usr_ / avtr_ / grp_）の登録は失敗する。
# X（x.com/...）と BOOTH（booth.pm/items/...）は認証不要なので影響を受けない。
VRCHAT_USERNAME=
VRCHAT_PASSWORD=
VRCHAT_TOTP_SECRET=

# クライアントIP・国を読むヘッダー。レート制限はこのIPで行う。
# 前段が Cloudflare なら既定のまま。nginx 直受けなら x-real-ip にする（deploy/nginx.conf 参照）。
# 未設定・ヘッダー無しだと IP が unknown になり、レート制限が効かなくなる。
CLIENT_IP_HEADER=cf-connecting-ip
CLIENT_COUNTRY_HEADER=cf-ipcountry
